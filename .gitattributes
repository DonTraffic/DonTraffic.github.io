# В репозитории хранится только LF. Без этого редактор на другой системе
# переписывает файл целиком, и в диффе тонут настоящие правки.
* text=auto eol=lf

# Бинарное git не трогает, но перечисляем явно: автоопределение ошибается
# на файлах, которые начинаются с текстоподобных байтов.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
